{
  "collectionName": "components_shared_social_links",
  "info": {
    "displayName": "Social Link",
    "description": "Red social o enlace externo"
  },
  "attributes": {
    "Platform": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Github",
        "LinkedIn",
        "Facebook",
        "Pinterest",
        "WhatsApp",
        "Telegram",
        "Reddit",
        "Email",
        "Instagram"
      ]
    },
    "Url": {
      "type": "string",
      "required": true
    },
    "UseIcon": {
      "type": "boolean",
      "default": false
    },
    "Icon": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "UseIcon"
            },
            true
          ]
        }
      },
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "CssClass": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "UseIcon"
            },
            false
          ]
        }
      },
      "required": true
    }
  }
}
