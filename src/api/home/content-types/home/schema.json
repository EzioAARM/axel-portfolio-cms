{
    "kind": "singleType",
    "collectionName": "home-pages",
    "info": {
        "singularName": "home",
        "pluralName": "homes",
        "displayName": "Home",
        "description": "Contenido de la página principal"
    },
    "attributes": {
        "heroTitle": { "type": "string", "required": true },
        "heroSubtitle": { "type": "text" },
        "heroImage": { "type": "media", "multiple": false },
        "featuredProjects": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::project.project"
        },
        "latestPosts": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::post.post"
        },
        "seo": {
            "type": "component",
            "repeatable": false,
            "component": "shared.seo"
        }
    }
}
